PORT=5000
JWT_SECRET=replace_this_with_a_64_char_random_string_use_openssl_rand_hex_32
# Allowed CORS origins (comma-separated).
# Local dev: include both the Next dev server and Express.
# Production (Hostinger): set to your actual domain, e.g. https://dev.northdryfruits.com
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5000
NODE_ENV=development

# Internal URL the Next.js server uses to reach the Express API during SSR.
# In the custom-server setup (same process) use http://localhost:<PORT>/api.
# On Hostinger this should be http://localhost:5000/api (or whatever PORT is).
SERVER_API_URL=http://localhost:5000/api

# MySQL Database Configuration
# For local development: use your local MySQL server (e.g. WAMP, XAMPP, or standalone MySQL).
# For Hostinger Business Web Hosting: these values are auto-provided when you create a MySQL
# database in the Hostinger panel and link it to your Node.js app. You can find them under:
#   Hosting → Manage → Databases → MySQL Databases → (your database) → Connection Details
# Typical Hostinger values:
#   DB_HOST=localhost (or the hostname shown in the panel)
#   DB_PORT=3306
#   DB_USER=u123456789_youruser
#   DB_PASSWORD=YourDatabasePassword
#   DB_NAME=u123456789_gbmarket
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gbmarket

# Admin Credentials (used by seed script to create the initial admin user)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisToASecurePassword

# Temporary: Secret key for the one-time /api/run-seed-once route (remove after first deploy)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SEED_TRIGGER_KEY=

# On-demand ISR revalidation of the Next.js frontend. When a product/blog/
# category is saved, the backend pings the Next site so its static page
# regenerates within seconds (instead of waiting for the ISR timer).
# REVALIDATE_URL:    Next site base URL (defaults to first CLIENT_ORIGIN, then localhost:5173)
# REVALIDATE_SECRET: must match REVALIDATE_SECRET in the Next app's env. Blank = disabled.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_URL=https://northdryfruits.com
REVALIDATE_SECRET=

# F3: Email notifications (optional — leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@mystore.com
ADMIN_EMAIL=

# WhatsApp order notifications via Wappfly (https://wappfly.com — free tier, leave blank to disable)
# Setup: sign up at wappfly.com, scan the QR code with your phone (WhatsApp > Linked Devices),
# then copy the API token from the dashboard. No Meta approval or templates needed.
# WAPPFLY_ADMIN_NUMBER is where order alerts are sent (international format, no + or spaces).
WAPPFLY_TOKEN=
WAPPFLY_ADMIN_NUMBER=923705621256
# Optional: override the send endpoint (defaults to the public Wappfly API)
WAPPFLY_API_URL=https://wappfly.com/api/messages/send

# Cloudinary Configuration
# Get these values from your Cloudinary dashboard at cloudinary.com after signing up (free tier). Leave blank to use local disk storage for development instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=